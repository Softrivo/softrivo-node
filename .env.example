# For `npm run smoke` (smoke.mjs). Use a TEST key only: the smoke writes.
SOFTRIVO_TEST_KEY=sk_test_...
# Optional: a public https URL that forwards to this machine's port 8787
# (for example a cloudflared quick tunnel). With it the smoke verifies the
# signature of a real webhook delivery; without it, of a locally signed sample.
# SMOKE_WEBHOOK_URL=https://xxxx.trycloudflare.com/softrivo
# SMOKE_PORT=8787

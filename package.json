{
  "name": "@softrivo/sdk",
  "version": "0.2.0",
  "description": "Official Node.js SDK for the Softrivo API: appointments, leads, availability, customers, conversations, WhatsApp messages, knowledge files, services, listings and webhooks for your Softrivo WhatsApp assistant.",
  "license": "MIT",
  "author": "Softrivo <contact@softrivo.com> (https://softrivo.com)",
  "homepage": "https://softrivo.com/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Softrivo/softrivo-node.git"
  },
  "bugs": {
    "url": "https://github.com/Softrivo/softrivo-node/issues"
  },
  "keywords": [
    "softrivo",
    "whatsapp",
    "api",
    "sdk",
    "appointments",
    "leads",
    "webhooks",
    "malaysia"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
